{
  "name": "clap-studio",
  "productName": "Clap Studio",
  "version": "1.0.0",
  "description": "Éditeur de sous-titres : génération automatique, import SRT/VTT/JSON, calage, style et export vidéo incrustée.",
  "main": "src/main.js",
  "author": "FezLaMala",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/FezLaMala/clap-studio.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fezlamala.clapstudio",
    "productName": "Clap Studio",
    "copyright": "© FezLaMala",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Clap-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clap Studio",
      "uninstallDisplayName": "Clap Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FezLaMala",
        "repo": "clap-studio",
        "releaseType": "release"
      }
    ]
  }
}
